{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "liveServer.settings.port": 5501,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/build/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/package-lock.json": true
  },
  "files.exclude": {
    "**/.cache": true
  }
}
