JWT_SECRET=somethingsecret
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/amazona?retryWrites=true&w=majority

PAYPAL_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_URL=
CLOUDINARY_API_SECRET=

GOOGLE_API_KEY=

MAILGUN_DOMIAN=
MAILGUN_API_KEY=

# اسم المرسل في الإيميلات
MAIL_FROM=

# أدمن البيانات الأولية. في production لو مفيش أدمن في القاعدة بيتعمل تلقائيًا من القيمتين دول
# (الباسورد 8 أحرف على الأقل، فيه حروف وأرقام)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true = يفتح /api/seed (قد يمسح البيانات) — للتطوير فقط، ومرفوض دايمًا لما NODE_ENV=production
ALLOW_SEED=false

# رابط الفرونت على Vercel
CORS_ORIGIN=https://redline-store-frontend.vercel.app

# نفس الرابط، يُستخدم في لينكات إيميل استعادة الباسورد
BASE_URL=https://redline-store-frontend.vercel.app

# بيئة التشغيل
NODE_ENV=production

# (اختياري) الضريبة والشحن على السيرفر — لازم تطابق frontend/src/config.js
# TAX_RATE=0.14
# SHIPPING_FEE=50
# FREE_SHIPPING_THRESHOLD=1000
